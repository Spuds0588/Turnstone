{
  "manifest_version": 3,
  "name": "Turnstone",
  "version": "0.1.0",
  "description": "Work through a spreadsheet link queue from the side panel: cards, statuses, notes, and real browser tabs that switch as you pick cards.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "tabs", "storage", "downloads", "contextMenus"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open the Turnstone queue",
    "default_icon": "icons/icon-192.png"
  },
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  }
}
