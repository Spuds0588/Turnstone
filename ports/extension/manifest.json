{
  "manifest_version": 3,
  "name": "Turnstone",
  "version": "0.1.0",
  "description": "Work through spreadsheet link queues from a side panel: cards, statuses, notes, and one-click tab switching.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "tabs", "storage", "downloads", "contextMenus"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Turnstone queue" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
