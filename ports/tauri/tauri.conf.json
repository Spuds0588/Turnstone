{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turnstone",
  "version": "0.1.0",
  "identifier": "io.github.spuds0588.turnstone",
  "build": {
    "frontendDist": "../../"
  },
  "app": {
    "windows": [
      {
        "title": "Turnstone",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Turnstone"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
